rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to read their own user profile document
    // so role verification and profile data can be authoritatively resolved
    // on both localhost and deployed environments.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Writes must go through the Spring Boot backend
    }

    // Default deny for all other collections (managed strictly via Spring Boot Admin SDK)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
